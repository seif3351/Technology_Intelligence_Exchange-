# Production settings for infra/deploy/compose.yml. Copy to atx.env (never commit it; chmod 600).
# Values marked SECRET belong in a secret store; if you keep them in this file, restrict access to the VM.

# Images built by CI: ghcr.io/<owner>/atx-node and atx-web, tagged with the full commit SHA.
ATX_IMAGE_REGISTRY=ghcr.io/your-github-owner
ATX_IMAGE_TAG=<full commit sha>

# Public hostnames (DNS A/AAAA records -> this VM). Caddy obtains TLS certificates for them.
ATX_WEB_HOST=app.example.com
ATX_API_HOST=api.example.com
ATX_MCP_HOST=mcp.example.com
ACME_EMAIL=ops@example.com

# Managed PostgreSQL 16 with the pgvector extension, in the pilot's region. SECRET (contains a password).
DATABASE_URL=postgres://atx:CHANGE_ME@db.example.internal:5432/atx
# verify (recommended) | require | off (only for --profile local-db on the private network)
DATABASE_SSL=verify
# PEM bundle of the provider's CA, when it is not in the system trust store:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----..."
# With --profile local-db: DATABASE_URL=postgres://atx:${POSTGRES_PASSWORD}@postgres:5432/atx and DATABASE_SSL=off
# POSTGRES_PASSWORD=

# SECRETS. Generate: `pnpm auth:generate-key` (private ES256 JWK, single line) and `openssl rand -base64 48`.
AUTH_SIGNING_JWK=
CONFIRMATION_SECRET=
ASSET_URL_SECRET=

# Email (verification, password reset, invitations, engagement notices). SECRET.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Automotive Technology Exchange <no-reply@example.com>"

# Pilot policy
REGISTRATION_MODE=invite
TERMS_VERSION=pilot-2026-10
# Consequential buyer actions stay off until the pilot agreement covers them.
FEATURE_ENGAGEMENT_ACTIONS=false

# Asset storage: filesystem (docker volume; include it in backups) or s3 (EU bucket).
STORAGE_DRIVER=filesystem
# S3_BUCKET=
# S3_REGION=eu-central-1

# Optional
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
EMBEDDINGS_PROVIDER=hashing
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
LOG_LEVEL=info
