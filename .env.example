# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://atx:atx@localhost:5432/atx
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MCP_PUBLIC_URL=http://localhost:4100/mcp
CORS_ORIGINS=http://localhost:3000

# Secrets: development defaults are rejected in production.
# CONFIRMATION_SECRET=
# ASSET_URL_SECRET=
# AUTH_SIGNING_JWK=      # private ES256 JWK (JSON); dev auto-generates .var/dev-signing-key.json

# Remote MCP authorization (OAuth 2.1 resource server). Defaults to the built-in issuer.
# MCP_AUTH_ISSUER=https://login.example.com/realms/atx
# MCP_AUTH_JWKS_URL=https://login.example.com/realms/atx/protocol/openid-connect/certs
MCP_REQUIRE_AUTH=false

STORAGE_DRIVER=filesystem
STORAGE_DIR=.var/storage
# STORAGE_DRIVER=s3
# S3_BUCKET=atx-assets
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# CLAMAV_HOST=localhost

# AI is optional; everything works deterministically without it.
AI_PROVIDER=none
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
EMBEDDINGS_PROVIDER=hashing

# Registration: invite (default; pilot) or open. Bump TERMS_VERSION whenever the terms change.
REGISTRATION_MODE=invite
# TERMS_VERSION=pilot-2026-10

# Email: file (development inbox in MAIL_DIR) | smtp (production; SMTP_URL is a secret) | none.
MAIL_DRIVER=file
# MAIL_DIR=.var/mail
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Automotive Technology Exchange <no-reply@example.com>"

# Consequential buyer actions (demo/workshop/PoC/RFI requests). Off by default.
FEATURE_ENGAGEMENT_ACTIONS=false

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
